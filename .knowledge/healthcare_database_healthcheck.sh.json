{"is_source_file": true, "format": "bash", "description": "This script performs a health check for MongoDB readiness by attempting multiple fallback methods such as mongosh ping, TCP connection, ss, netstat, and process checks to determine if MongoDB is available and listening on port 27017 or a user-specified port.", "external_files": ["bash", "mongosh", "ss", "netstat", "lsof"], "external_methods": ["command -v", "timeout", "pgrep", "lsof", "grep", "echo"], "published": [], "classes": [], "methods": [{"name": "debug_log", "description": "Logs debug messages if DEBUG mode is enabled."}], "calls": ["command -v mongosh", "mongosh --port \"${PORT}\" --quiet --eval \"db.adminCommand('ping')\"", "timeout 2 bash -c \"echo > /dev/tcp/${HOST}/${PORT}\"", "command -v ss", "ss -tlnp", "grep -q \":${PORT} \"", "[ \"${DEBUG}\" = \"true\" ]", "echo > /dev/tcp/${HOST}/${PORT}", "command -v netstat", "netstat -tlnp", "pgrep -x mongod", "command -v lsof", "lsof -i \":${PORT}\" -sTCP:LISTEN"], "search-terms": ["mongodb health check shell script", "mongosh ping fallback", "TCP port check script", "bash MongoDB port health check", "system commands for port listening"], "state": 2, "file_id": 10, "knowledge_revision": 46, "git_revision": "b995ae884afb60ed312446f8964f7078e7c932e4", "revision_history": [{"24": "51037408e22cc8bddbba479dfc00fa07b85ecf45"}, {"34": "a64069c3018c53721f8f41bf9664e93263db409d"}, {"46": "b995ae884afb60ed312446f8964f7078e7c932e4"}], "hash": "524e8cf4308eb1487b49c421bd48edaf", "format-version": 4, "code-base-name": "healthcare_database", "filename": "healthcare_database/healthcheck.sh"}