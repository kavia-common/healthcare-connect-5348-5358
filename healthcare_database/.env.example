# MongoDB Database Environment (example)
# Copy to .env and adjust values for your environment

# Core database settings
DB_NAME=myapp
DB_USER=appuser
DB_PASSWORD=dbuser123

# Port configuration
# Note: Some scripts default to a specific port. Set this to match your runtime.
# Common options:
#   27017 - Standard MongoDB default port (recommended)
#   5000  - If your local startup.sh is using this default in your environment
DB_PORT=27017

# Enable authentication (if your setup supports it in startup scripts)
# true/false
ENABLE_AUTH=false

# Convenience variables for tools (db_visualizer, seed script, etc.)
# Use the DB_NAME above for MONGODB_DB, and provide a URL suitable for your environment.
# Example development URL without auth:
#   mongodb://localhost:${DB_PORT}/
# Example with auth (ensure users exist and auth is enabled):
#   mongodb://appuser:dbuser123@localhost:${DB_PORT}/?authSource=admin
MONGODB_URL=mongodb://localhost:${DB_PORT}/
MONGODB_DB=${DB_NAME}
