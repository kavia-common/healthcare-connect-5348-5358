# MongoDB connection information for local development
# Copy this file to .env and fill in values as appropriate.

# Full MongoDB connection URI (local or Atlas)
# Examples:
#   mongodb://localhost:27017
#   mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# Logical database name to use for this project
DB_NAME=healthcare_connect_dev
