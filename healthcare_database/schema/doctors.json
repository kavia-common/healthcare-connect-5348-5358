{
  "title": "Doctors Collection Schema",
  "description": "JSON-like schema definition for 'doctors' collection to guide backend validation and optional MongoDB validator configuration.",
  "bsonType": "object",
  "required": ["user_id", "first_name", "last_name", "specialty", "created_at"],
  "additionalProperties": false,
  "properties": {
    "_id": {
      "bsonType": "objectId",
      "description": "Unique identifier generated by MongoDB."
    },
    "user_id": {
      "bsonType": "objectId",
      "description": "Reference to the user document (role=doctor)."
    },
    "first_name": {
      "bsonType": "string",
      "description": "Doctor's first name."
    },
    "last_name": {
      "bsonType": "string",
      "description": "Doctor's last name."
    },
    "specialty": {
      "bsonType": "string",
      "description": "Medical specialty (e.g., Cardiology, Pediatrics)."
    },
    "bio": {
      "bsonType": "string",
      "description": "Short biography."
    },
    "years_of_experience": {
      "bsonType": ["int", "long", "double", "decimal"],
      "description": "Years of professional experience.",
      "minimum": 0
    },
    "clinic": {
      "bsonType": "object",
      "description": "Clinic details.",
      "additionalProperties": false,
      "properties": {
        "name": { "bsonType": "string" },
        "address": { "bsonType": "string" }
      }
    },
    "languages": {
      "bsonType": "array",
      "description": "Languages spoken by the doctor.",
      "items": { "bsonType": "string" }
    },
    "created_at": {
      "bsonType": "date",
      "description": "Creation timestamp."
    },
    "updated_at": {
      "bsonType": "date",
      "description": "Last update timestamp."
    },
    "metadata": {
      "bsonType": "object",
      "description": "Optional metadata object for extensibility.",
      "additionalProperties": true
    }
  }
}
