{
  "title": "Users Collection Schema",
  "description": "JSON-like schema definition for 'users' collection to guide backend validation and optional MongoDB validator configuration.",
  "bsonType": "object",
  "required": ["email", "password_hash", "role", "created_at"],
  "additionalProperties": false,
  "properties": {
    "_id": {
      "bsonType": "objectId",
      "description": "Unique identifier generated by MongoDB."
    },
    "email": {
      "bsonType": "string",
      "description": "User email (unique, stored in lowercase)."
    },
    "password_hash": {
      "bsonType": "string",
      "description": "Hashed password using a secure algorithm such as bcrypt."
    },
    "role": {
      "bsonType": "string",
      "enum": ["patient", "doctor", "admin"],
      "description": "Role assigned to the user."
    },
    "status": {
      "bsonType": "string",
      "enum": ["active", "inactive", "blocked"],
      "description": "Account status indicator.",
      "default": "active"
    },
    "last_login": {
      "bsonType": "date",
      "description": "Timestamp of the user's last login."
    },
    "created_at": {
      "bsonType": "date",
      "description": "Creation timestamp."
    },
    "updated_at": {
      "bsonType": "date",
      "description": "Last update timestamp."
    },
    "metadata": {
      "bsonType": "object",
      "description": "Optional metadata object for extensibility.",
      "additionalProperties": true
    }
  }
}
