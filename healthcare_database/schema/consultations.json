{
  "title": "Consultations Collection Schema",
  "description": "JSON-like schema definition for 'consultations' collection to guide backend validation and optional MongoDB validator configuration.",
  "bsonType": "object",
  "required": ["patient_id", "doctor_id", "datetime", "status", "created_at"],
  "additionalProperties": false,
  "properties": {
    "_id": {
      "bsonType": "objectId",
      "description": "Unique identifier generated by MongoDB."
    },
    "patient_id": {
      "bsonType": "objectId",
      "description": "Reference to the patient document."
    },
    "doctor_id": {
      "bsonType": "objectId",
      "description": "Reference to the doctor document."
    },
    "datetime": {
      "bsonType": "date",
      "description": "Consultation scheduled start datetime."
    },
    "status": {
      "bsonType": "string",
      "enum": ["scheduled", "completed", "cancelled"],
      "description": "Consultation status."
    },
    "reason": {
      "bsonType": "string",
      "description": "Reason for visit."
    },
    "notes": {
      "bsonType": "string",
      "description": "Provider notes."
    },
    "duration_minutes": {
      "bsonType": ["int", "long", "double", "decimal"],
      "description": "Duration of consultation in minutes."
    },
    "created_at": {
      "bsonType": "date",
      "description": "Creation timestamp."
    },
    "updated_at": {
      "bsonType": "date",
      "description": "Last update timestamp."
    },
    "metadata": {
      "bsonType": "object",
      "description": "Optional metadata object for extensibility.",
      "additionalProperties": true
    }
  }
}
