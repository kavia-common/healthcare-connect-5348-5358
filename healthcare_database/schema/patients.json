{
  "title": "Patients Collection Schema",
  "description": "JSON-like schema definition for 'patients' collection to guide backend validation and optional MongoDB validator configuration.",
  "bsonType": "object",
  "required": ["user_id", "first_name", "last_name", "date_of_birth", "gender", "created_at"],
  "additionalProperties": false,
  "properties": {
    "_id": {
      "bsonType": "objectId",
      "description": "Unique identifier generated by MongoDB."
    },
    "user_id": {
      "bsonType": "objectId",
      "description": "Reference to the user document."
    },
    "first_name": {
      "bsonType": "string",
      "description": "Patient's first name."
    },
    "last_name": {
      "bsonType": "string",
      "description": "Patient's last name."
    },
    "date_of_birth": {
      "bsonType": "date",
      "description": "Patient's date of birth."
    },
    "gender": {
      "bsonType": "string",
      "enum": ["male", "female", "other", "unknown"],
      "description": "Patient's gender."
    },
    "phone": {
      "bsonType": "string",
      "description": "Primary phone number."
    },
    "address": {
      "bsonType": "object",
      "description": "Patient's address.",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "line1": { "bsonType": "string" },
        "line2": { "bsonType": "string" },
        "city": { "bsonType": "string" },
        "state": { "bsonType": "string" },
        "postal_code": { "bsonType": "string" },
        "country": { "bsonType": "string" }
      }
    },
    "emergency_contact": {
      "bsonType": "object",
      "description": "Emergency contact details.",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "name": { "bsonType": "string" },
        "phone": { "bsonType": "string" },
        "relationship": { "bsonType": "string" }
      }
    },
    "insurance": {
      "bsonType": "object",
      "description": "Insurance details.",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "provider": { "bsonType": "string" },
        "member_id": { "bsonType": "string" },
        "group_number": { "bsonType": "string" }
      }
    },
    "notes": {
      "bsonType": "string",
      "description": "Additional notes about the patient."
    },
    "created_at": {
      "bsonType": "date",
      "description": "Creation timestamp."
    },
    "updated_at": {
      "bsonType": "date",
      "description": "Last update timestamp."
    },
    "metadata": {
      "bsonType": "object",
      "description": "Optional metadata object for extensibility.",
      "additionalProperties": true
    }
  }
}
