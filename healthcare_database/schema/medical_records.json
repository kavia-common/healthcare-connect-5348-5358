{
  "title": "Medical Records Collection Schema",
  "description": "JSON-like schema definition for 'medical_records' collection to guide backend validation and optional MongoDB validator configuration.",
  "bsonType": "object",
  "required": ["patient_id", "doctor_id", "record_type", "created_at"],
  "additionalProperties": false,
  "properties": {
    "_id": {
      "bsonType": "objectId",
      "description": "Unique identifier generated by MongoDB."
    },
    "patient_id": {
      "bsonType": "objectId",
      "description": "Reference to the patient document."
    },
    "doctor_id": {
      "bsonType": "objectId",
      "description": "Reference to the doctor document."
    },
    "record_type": {
      "bsonType": "string",
      "enum": ["prescription", "diagnosis", "lab_result", "note", "imaging"],
      "description": "Type of the medical record."
    },
    "description": {
      "bsonType": "string",
      "description": "Human-readable description of the record."
    },
    "attachments": {
      "bsonType": "array",
      "description": "List of attachment references (e.g., URLs or file IDs).",
      "items": {
        "bsonType": "object",
        "additionalProperties": false,
        "properties": {
          "file_name": { "bsonType": "string" },
          "file_url": { "bsonType": "string" },
          "content_type": { "bsonType": "string" }
        }
      }
    },
    "created_at": {
      "bsonType": "date",
      "description": "Creation timestamp."
    },
    "updated_at": {
      "bsonType": "date",
      "description": "Last update timestamp."
    },
    "metadata": {
      "bsonType": "object",
      "description": "Optional metadata object for extensibility.",
      "additionalProperties": true
    }
  }
}
